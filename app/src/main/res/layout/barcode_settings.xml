<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/barcodeSettingsTriggerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/misnapSampleAppSettingsBarcodeTriggerLabel" />

        <Spinner
            android:id="@+id/barcodeSettingsTriggerSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/barcodeTriggerArray" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barcodeSettingsTypeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapSampleAppLayoutVerticalMargin"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barcodeSettingsTriggerContainer">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeLabel" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeQrCodeCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeQrCodeLabel" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeDataMatrixCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeDataMatrixLabel" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeRssCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeRssLabel" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeCode39Checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeCode39Label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeCode128Checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeCode128Label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypePdf417Checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypePdf417Label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeAztecCodeCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeAztecCodeLabel" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeCode2Of5Checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeCode2Of5Label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeCode93Checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeCode93Label" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/barcodeSettingsTypeCodabarCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/misnapSampleAppSettingsBarcodeTypeCodabarLabel" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/barcodeSettingsScanSpeedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapSampleAppLayoutVerticalMargin"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barcodeSettingsTypeContainer">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/misnapSampleAppSettingsBarcodeScanSpeedLabel" />

        <Spinner
            android:id="@+id/barcodeSettingsScanSpeedSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/barcodeScanSpeedsArray" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/barcodeSettingsOrientationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/misnapSampleAppLayoutVerticalMargin"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barcodeSettingsScanSpeedContainer">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/misnapSampleAppSettingsBarcodeOrientationLabel" />

        <Spinner
            android:id="@+id/barcodeSettingsOrientationSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/barcodeOrientationsArray" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
